#!/bin/sh
set -e
if [ "$1" = configure ]; then
    ln -sf /opt/vimora/bin/vimora-student /usr/local/bin/vimora-student
    # Up to 0.3.27 the program was called vimora-client: programs still running under that
    # name restart through this link and land on the new one.
    rm -f /usr/local/bin/vimora-client
    ln -sf /opt/vimora/bin/vimora-student /opt/vimora/bin/vimora-client
    # Writes /etc/vimora (keeps an existing pairing and name), installs and (re)starts
    # vimora-service.service — the root part: Shadow, updates, NetControl.
    /opt/vimora/bin/vimora-student setup || echo "vimora: service setup failed" >&2
    chmod 644 /etc/vimora/client.json 2>/dev/null || true
    # Files the teacher sends: inside Vimora's own folder, writable by every user (sticky).
    mkdir -p /opt/vimora/files
    chmod 1777 /opt/vimora/files
    # Update check on its own timer, apart from the service (signed releases only).
    rm -f /opt/vimora/bin/vimora-updater
    cat > /etc/systemd/system/vimora-updater.service <<'UNIT'
[Unit]
Description=Vimora update check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/vimora/bin/vimora-student update-now
UNIT
    cat > /etc/systemd/system/vimora-updater.timer <<'UNIT'
[Unit]
Description=Vimora update check (5 minutes after start-up, then every 4 hours)

[Timer]
OnBootSec=5min
OnUnitActiveSec=4h
Persistent=true

[Install]
WantedBy=timers.target
UNIT
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable --now vimora-updater.timer 2>/dev/null || true
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
        ufw allow 47800/udp >/dev/null || true
    fi
    # First install only: screen capture and the lock screen need an X11 session.
    if [ -z "$2" ] && [ -f /etc/gdm3/custom.conf ]; then
        if grep -q '^#\?WaylandEnable' /etc/gdm3/custom.conf; then
            sed -i 's/^#\?WaylandEnable=.*/WaylandEnable=false/' /etc/gdm3/custom.conf
        else
            sed -i '/^\[daemon\]/a WaylandEnable=false' /etc/gdm3/custom.conf
        fi
        echo "vimora: GDM switched to X11 (takes effect after a restart)"
    fi
fi
