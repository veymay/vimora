#!/bin/sh
set -e
# Upgrades keep the service running; only a real removal stops it.
if [ "$1" = remove ]; then
    systemctl disable --now vimora-service 2>/dev/null || true
    systemctl disable --now vimora-updater.timer 2>/dev/null || true
    rm -f /etc/systemd/system/vimora-service.service
    rm -f /etc/systemd/system/vimora-updater.service /etc/systemd/system/vimora-updater.timer
    systemctl daemon-reload 2>/dev/null || true
    pkill -x vimora-student 2>/dev/null || true
    # Nothing of Vimora may stay: settings it changed, pairing, every user's files.
    /opt/vimora/bin/vimora-student purge 2>/dev/null || true
fi
